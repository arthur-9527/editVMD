# ============================================================
# editVMD 后端环境变量（复制为 backend/.env 后按需修改）
#
# ★ Docker 部署请用「仓库根目录」的 .env.example（与 docker-compose.yml 同目录）；
#   本文件只用于本地开发（scripts/dev.sh）。
#
#   cp backend/.env.example backend/.env
#
# 前缀 EDITVMD_ 由 pydantic-settings 读取。
# 侧边栏 AI 仅需填 EDITVMD_AI_API_KEY（DeepSeek 官方 API Key）；
# 网关与模型已写死，不需要配置任何 ANTHROPIC_* 变量。
# ============================================================

# ------------------------------------------------------------ 数据库
# 本机开发（docker compose up -d db，宿主机 55432）；
# Docker 部署由 compose 覆盖为 db:5432，不需要改这里。
EDITVMD_DATABASE_URL=postgresql+psycopg2://editvmd:editvmd@127.0.0.1:55432/editvmd

# ------------------------------------------------------------ 存储根
# 上传的 PMX / VMD 与系统生成物都落在这里。
# ★ 留空即用默认值 <仓库根>/storage；Docker 部署由 compose 覆盖为 /data/storage。
# EDITVMD_STORAGE=

# ------------------------------------------------------------ 侧边栏 AI
EDITVMD_AI_ENABLED=true

# ★ AI 唯一可读写根目录（SDK 的 cwd，不配 add_dirs）
#   默认 <仓库根>/storage/ai_workspace；想让 AI 帮你看源码，可改成仓库根目录。
#   Docker 部署由 compose 覆盖为 /data/storage/ai_workspace。
# EDITVMD_AI_WORKDIR=

# 单次任务最多几步（达到上限前端会提示「继续执行」）
EDITVMD_AI_MAX_TURNS=20

# 不做审批回调，直接放行
EDITVMD_AI_PERMISSION_MODE=bypassPermissions

# ★ 基础工具白名单（tools）：只暴露这些内置工具。
#   刻意**不含 Task / Agent** —— 从源头禁止派生后台子 agent，
#   避免「后台悄悄跑、前端看不到也停不了」。
EDITVMD_AI_TOOLS=Read,Write,Edit,Glob,Grep,Bash,WebSearch,WebFetch

# ★ 显式禁用（disallowed_tools）：即使白名单写错也不会放进来
EDITVMD_AI_DENY_TOOLS=Task,Agent

# ★ 禁止后台执行：PreToolUse 钩子拦截 Task 与 Bash 的 run_in_background
#   普通前台 Bash / 搜索不受影响。
EDITVMD_AI_DENY_BACKGROUND=true

# ★ 串行：同一会话上一轮未结束时拒绝新消息（一次只跑一条）
EDITVMD_AI_SERIAL=true

# 自动放行（不走审批）的工具（逗号分隔）
#   Read/Write/Edit/Glob/Grep  文件读写（受 cwd 限制）
#   Bash                       跑脚本（注意：可 cd 出目录，严格隔离时删掉它）
#   WebSearch/WebFetch         联网搜索与抓网页
EDITVMD_AI_ALLOWED_TOOLS=Read,Write,Edit,Glob,Grep,Bash,WebSearch,WebFetch

# 同时存活的会话数上限（超出按 LRU 回收）
EDITVMD_AI_MAX_SESSIONS=10

# ------------------------------------------------------------ 媒体（视频 → 动作）
# 两条能力：
#   1) 文本 → 动作：AI 用固定首帧 pose.png + 文本，经 MiniMax-H3 图生视频
#      → 动捕 → glb2vmd，产出 VMD（工具名 generate_action_from_text）。
#   2) 参考视频 → 动作：用户在「视频参考窗口」上传 mp4 → 动捕 → glb2vmd。
EDITVMD_MEDIA_ENABLED=true

# ★ MiniMax-H3 图生视频（能力1 用），Metaso（秘塔）中转，Key 以 mk- 开头。
#   在 https://metaso.cn 开发者控制台获取。
EDITVMD_METASO_API_KEY=

# ★ AnimChar 动捕（能力1/2 共用），Key 在 https://animchar.com 账号设置获取。
#   区域固定 CN（中国内地），不需要配置。
EDITVMD_ANIMCHAR_API_KEY=

# 说明：glb2vmd 转换器已内嵌进本系统（backend/app/media/glb2vmd_core/），
#       目标 PMX 自动取「当前系统正在用的模型」，都不需要额外配置。

# 参考视频上限（超过则拒绝上传）
EDITVMD_VIDEO_MAX_SECONDS=30
EDITVMD_VIDEO_MAX_MB=200

# 追加到内置人设之后的自定义提示（可留空）
EDITVMD_AI_SYSTEM_PROMPT=

# ------------------------------------------------------------ AI 认证
# ★ 只需填这一行：DeepSeek 官方 API Key（sk- 开头）。
#   在 https://platform.deepseek.com 创建。
#   网关与模型已写死：https://api.deepseek.com/anthropic + deepseek-flash；
#   不需要再配 ANTHROPIC_BASE_URL / EDITVMD_AI_MODEL。
#   填完重启后端（已启动的 CLI 子进程不会重读环境变量）。
EDITVMD_AI_API_KEY=
