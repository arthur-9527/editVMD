# ============================================================
# editVMD 配置（Docker 部署）
#
#   cp .env.example .env
#   docker compose up -d --build
#
# 只有 API Key 需要按需填写，其余保持默认即可。
# 不填任何 Key 也能正常运行（仅 AI 助手 / 视频生成不可用）。
# ============================================================

# ------------------------------------------------------------ 数据库
# 容器内用户 / 库固定为 editvmd，只需要改密码（compose 会自动同步到连接串）
POSTGRES_PASSWORD=editvmd

# ------------------------------------------------------------ AI 助手（可选）
# DeepSeek 官方 API Key：https://platform.deepseek.com
# 不填则侧边栏「AI 助手」不可用，其余功能正常。
EDITVMD_AI_API_KEY=

# ------------------------------------------------------------ 文本 / 视频 → 动作（可选）
# MiniMax-H3 图生视频（Metaso 中转，mk- 开头）：https://metaso.cn
EDITVMD_METASO_API_KEY=
# AnimChar 动捕：https://animchar.com
EDITVMD_ANIMCHAR_API_KEY=

# ------------------------------------------------------------ 可选开关（一般不用改）
# EDITVMD_AI_ENABLED=true
# EDITVMD_MEDIA_ENABLED=true
# EDITVMD_AI_MAX_TURNS=20
